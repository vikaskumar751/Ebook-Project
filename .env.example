# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -------------------------------------------------------------
# OPTION A: STRIPE CONFIGURATION
# -------------------------------------------------------------
# Get your Secret Key from: https://dashboard.stripe.com/apikeys
# Use sk_test_... for sandbox or sk_live_... for production.
STRIPE_SECRET_KEY="sk_test_..."

# Get your Webhook Secret from: https://dashboard.stripe.com/webhooks
# Add an endpoint pointing to: https://YOUR_DOMAIN/api/webhooks/stripe
# Select event: checkout.session.completed
STRIPE_WEBHOOK_SECRET="whsec_..."

# (Optional) Public key for Stripe Elements on frontend
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# -------------------------------------------------------------
# OPTION B: LEMON SQUEEZY CONFIGURATION
# -------------------------------------------------------------
# Get your API Key from: https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY="your_api_key_here"

# Get your Store ID and Variant ID from your Lemon Squeezy product setup
LEMONSQUEEZY_STORE_ID="123456"
LEMONSQUEEZY_VARIANT_ID="789012"

# Set a signing secret under Lemon Squeezy Webhooks:
# Add an endpoint pointing to: https://YOUR_DOMAIN/api/webhooks/lemonsqueezy
# Select event: order_created
LEMONSQUEEZY_WEBHOOK_SECRET="your_custom_webhook_secret_here"

# -------------------------------------------------------------
# OPTION C: RAZORPAY INTERNATIONAL CONFIGURATION
# -------------------------------------------------------------
# Enable International Payments in Razorpay:
# Razorpay Dashboard -> Account & Settings -> International Payments (Enable USD, EUR, etc.)
# Get API Key ID & Secret from: https://dashboard.razorpay.com/app/keys
# Use rzp_test_... for sandbox or rzp_live_... for production.
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"

# Get your Webhook Secret from: Dashboard -> Account & Settings -> Webhooks
# Add an endpoint pointing to: https://YOUR_DOMAIN/api/webhooks/razorpay
# Select events: order.paid, payment.captured
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Public Key ID for browser client:
VITE_RAZORPAY_KEY_ID="rzp_test_..."
